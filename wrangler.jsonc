{
  // 会社サイトとしての名前。プロダクトが増えても変えない。URL には出ない（ドメインは routes で割り当てる）。
  "name": "lucid-brain-site",
  // Workers 側の挙動変化に巻き込まれないよう固定する（SPEC §7.5）。
  "compatibility_date": "2026-09-11",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 拡張子なしURLで配信し、.html 付きURLは拡張子なしへ転送する（SPEC §3）。
    "html_handling": "auto-trailing-slash",
    // 存在しないURLで、最も近い親ディレクトリの 404.html を 404 ステータスで返す。
    // /en/ 配下は public/en/404.html が当たる（SPEC §7.4）。
    "not_found_handling": "404-page"
  },
  // 自分のドメインで配信する。DNS レコードと証明書はデプロイ時に Cloudflare が作る（SPEC §3 / §7.7）。
  // 前提: lucidbrain.jp がこのアカウントのゾーンとして有効になっていること。
  // 本体は www なし。www は DNS と証明書を作らせるためだけに置き、転送はダッシュボードの
  // リダイレクトルールが行う（静的ファイルは Worker を通らないため、worker.js では全ページに効かない・SPEC §3 / §8.1）。
  "routes": [
    { "pattern": "lucidbrain.jp", "custom_domain": true },
    { "pattern": "www.lucidbrain.jp", "custom_domain": true }
  ],
  // *.workers.dev では配信しない。URL を1つに絞り、Access を掛け漏らす入口を作らないため。
  "workers_dev": false,
  // 版ごとのプレビューURLも出さない。確認はテスト環境（env.staging）で行う。
  "preview_urls": false,
  "vars": {
    // 公開URL。Stripe の success_url / cancel_url のベースで、scripts/ops.mjs の Webhook 宛先とスモークの対象にもなる。
    // routes と必ず一致させる。
    "SITE_BASE_URL": "https://lucidbrain.jp"
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      // 全プロダクトの配布ファイルを1つのバケットに置き、中をプロダクトIDのフォルダで分ける（SPEC §8.5）。
      "bucket_name": "lucid-brain-releases"
    }
  ],
  // 障害時に手掛かりを残す。1行で済み、ダッシュボード操作が要らない（SPEC §7.5 / §8.4）。
  "observability": { "enabled": true },

  // テスト環境。develop ブランチから出す。Worker は lucid-brain-site-staging になる（SPEC §7.7）。
  // routes / vars / r2_buckets は wrangler の仕様で継承されないため、ここに書き直す。
  // アクセス制限は Cloudflare Access（ダッシュボード）で掛ける。ここには書けない。
  "env": {
    "staging": {
      "routes": [{ "pattern": "staging.lucidbrain.jp", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "SITE_BASE_URL": "https://staging.lucidbrain.jp"
      },
      "r2_buckets": [
        {
          "binding": "RELEASES",
          // 本番の latest を上書きしないよう、テスト用の exe は別のバケットに置く
          "bucket_name": "lucid-brain-releases-staging"
        }
      ]
    }
  }
}
