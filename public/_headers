# セキュリティヘッダとキャッシュ制御（SPEC §2.3 / §7.5）。
#
# ダッシュボードではなくリポジトリ内の設定ファイルで解く。git の差分で追えるようにするためである（SPEC §1.2）。
# 書き方を誤ると本番でだけ壊れるため、リリース前に実機で確認する（SPEC §7.4）。

/*
  # 外部からの読み込みはゼロ。フォントはセルフホストし、JS フレームワークも読み込まない（SPEC §2.3）。
  # インラインスクリプト・インラインスタイルを書かない構成にしてあるので unsafe-inline は要らない。
  #
  # アナリティクス（Cloudflare Web Analytics）を入れるときは、この行の script-src と connect-src に
  #   https://static.cloudflareinsights.com  （script-src）
  #   https://cloudflareinsights.com         （connect-src）
  # を足す。§2.3 の「外部読み込みゼロ」の唯一の例外になる。
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # 使わない機能は明示的に切る。最小限にとどめる（SPEC §7.5）。
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # 既定は「毎回確認させる」。中身が変わっていなければ 304 が返るだけで、転送量は増えない。
  # ここを既定にしておく理由は2つある。
  #   1. HTML が古いままだと、直した文言や構成がいつまでも出ない
  #   2. 下でこれを上書きし損ねたパスがあっても、古いものが残るのではなく毎回確認する側に転ぶ
  # 拡張子なしURLで配信するため（§3）、パスの形で HTML を選び分けようとすると漏れる。
  Cache-Control: public, no-cache

# CSS・JS も毎回確認させる。上の /* と同じ値であり、消しても挙動は変わらないが、
# 「ここを長くしてはいけない」という判断をファイルに残すために明示しておく。
#
# ファイル名にハッシュを付けられない（ビルドを持たない・§1.2）。
# そのため max-age を1秒でも与えると、その秒数のあいだ「新しいHTML + 古いCSS」の組み合わせが
# 成立しうる。ヘッダー・フッターの高さトークンがズレて、隙間の空いた壊れた画面になる。
# 実際にこれで壊れた。max-age で窓を狭めても消えないので、窓そのものを作らない。
#
# 代償は、資産ごとに条件付きリクエストが1往復増えることだけである。中身が変わっていなければ
# 304 が返り、本文は転送されない。CSS 4本 + JS 2〜3本のこの規模では体感に出ない。
#
# 将来ビルドを入れてファイル名にハッシュを付けるなら、そのときは max-age=31536000, immutable にできる。
# ハッシュ無しで長いキャッシュにする、という組み合わせだけは取らない。
#
# パスの途中に * は書かない。末尾以外の * は当たらず、規則ごと無効になる。
# 1区切りぶんは :name のプレースホルダで受ける（ここでは <slug> が入る）。
/assets/*
  Cache-Control: public, no-cache

/products/:product/assets/*
  Cache-Control: public, no-cache

# 配布物。人に渡すURLであり、差し替えが起きうるので長く持たせない。
/docs/*
  Cache-Control: public, max-age=600, must-revalidate
